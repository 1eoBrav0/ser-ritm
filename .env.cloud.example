# Copy to .env.cloud ONLY on the hosting account. Do not commit the filled file.
BOT_TOKEN=
PUBLIC_URL=https://YOUR_USERNAME.pythonanywhere.com
# Generate two distinct keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
CRON_SECRET=
# Persistent directory, relative to the project or absolute; never a temporary directory.
DATA_DIR=data

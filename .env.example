# Copy to .env. Keep the real token out of Git and chat messages.
BOT_TOKEN=
# Optional fixed HTTPS address for a future server; run_telegram.py makes a temporary address itself.
PUBLIC_URL=
HOST=127.0.0.1
PORT=8765
# start.cmd is local-only; start-telegram.cmd starts the separate Telegram app on port 8766.
DEMO_MODE=1
